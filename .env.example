# Application Environment
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_NAME=enterprisedb
DB_USER=dbadmin
DB_PASSWORD=your-secure-password-here

# API Security
API_KEY=your-api-key-here

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Grafana Configuration (docker-compose only)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=your-secure-password-here

# Terraform Variables (set via environment for remote backend)
# TF_VAR_db_password=your-secure-db-password

# AWS Configuration (for Terraform)
# AWS_REGION=eu-north-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
